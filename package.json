{
  "name": "@daxiong888/mcp-jenkins",
  "version": "3.0.0-rc.3",
  "description": "Jenkins MCP server with reliable writes and safe multi-instance routing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-jenkins": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "inspect:dev": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration:docker": "npm run build && node test/integration/docker-multi-instance.mjs",
    "test:integration:docker:matrix": "npm run build && node test/integration/docker-version-matrix.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "jenkins",
    "mcp",
    "mcp-server",
    "automation",
    "ci-cd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daxiong888/mcp-jenkins.git"
  },
  "homepage": "https://github.com/daxiong888/mcp-jenkins#readme",
  "bugs": {
    "url": "https://github.com/daxiong888/mcp-jenkins/issues"
  },
  "author": "daxiong888",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.4"
  }
}
